{
  "name": "@te-digital/lgpd-consent-react",
  "version": "0.2.1",
  "description": "React adapter for @te-digital/lgpd-consent. Hooks and headless components.",
  "keywords": [
    "lgpd",
    "lgpd-consent",
    "cookie-consent",
    "react",
    "react-hooks",
    "headless",
    "consent",
    "brazil",
    "anpd",
    "privacy",
    "google-consent-mode"
  ],
  "homepage": "https://tedigital.com.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/te-digital-tech/lgpd-consent.git",
    "directory": "packages/lgpd-consent-react"
  },
  "bugs": {
    "url": "https://github.com/te-digital-tech/lgpd-consent/issues"
  },
  "author": "T&E Digital <contato@tedigital.com.br> (https://tedigital.com.br)",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@te-digital/lgpd-consent": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.7",
    "happy-dom": "^15.11.7",
    "react": "^19.0.0"
  }
}
